{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "latch-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-17",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},

	// フロントエンド配信(Workers Assets・F2'計画Task 2)。/v1/*と/healthzは必ず
	// Workerが先に処理し、それ以外のパスはapps/web/distをSPAとして配信
	// (未一致はindex.htmlへ倒す)。
	// run_worker_firstが無いとassets側が/v1/*へのPOSTに405を返す(assetsは
	// GET/HEAD以外をWorkerへ迂回させないため必須)。/healthzも含めるのは
	// SPAフォールバックのindex.htmlで代替応答に隠れないようにするため
	// (E2E/監視のヘルスチェックがWorkerに届く)。
	// /__scheduledも含めるのは、wrangler dev --test-scheduledのCron強制発火
	// (GET /__scheduled・F3計画Task 14)がassetsのSPAフォールバックで代替され、
	// scheduledハンドラに届かなくなるのを防ぐため(/v1/*と同じ理由)。
	// distは `pnpm --filter web build` の生成物(E2E/デプロイ前にビルドする)
	"assets": {
		"directory": "../web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/v1/*", "/healthz", "/__scheduled"]
	},

	// D1(リレーショナルDB・docs/04 §2)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "latch-db",
			// デプロイ時に実IDへ差し替え
			"database_id": "00000000-0000-0000-0000-000000000000",
			// D1マイグレーション置き場(drizzle-kit生成SQL・docs/04 §3.1)
			"migrations_dir": "migrations"
		}
	],

	// トークン失効用KV(docs/04 §4・05 §2.3)
	"kv_namespaces": [
		{
			"binding": "REVOCATION_KV",
			// デプロイ時に実IDへ差し替え
			"id": "00000000000000000000000000000000"
		},
		{
			// circuit breaker・予算アラートの送信済み印(docs/06 §5・§6)
			"binding": "PIPELINE_KV",
			// デプロイ時に実IDへ差し替え
			"id": "00000000000000000000000000000000"
		}
	],

	// ユーザーアイコン保存(docs/04 §3.1)
	"r2_buckets": [
		{
			"binding": "ICONS",
			"bucket_name": "icons"
		}
	],

	// Layer 2 Candidate Retrieval用ベクトルインデックス。作成コマンド(07 §1の指定値に基づく):
	//   wrangler vectorize create latch-intents --dimensions 1024 --metric cosine --metadata-index form,status,category
	"vectorize": [
		{
			"binding": "VECTORS",
			"index_name": "latch-intents"
		}
	],

	// Workers AI(Embedding=bge-m3・docs/07 §1)
	"ai": {
		"binding": "AI"
	},

	// マッチングパイプラインのイベントキュー(docs/04 §2)
	"queues": {
		"producers": [
			{
				"binding": "MATCH_QUEUE",
				"queue": "match-events"
			}
		],
		"consumers": [
			{
				"queue": "match-events",
				"max_retries": 3,
				// 1件目が来てから待つ秒数。既定(5秒)だと小さいバッチでも5秒待つため1秒にする(#19)
				"max_batch_timeout": 1,
				"dead_letter_queue": "match-events-dlq"
			},
			{
				// DLQを見る最小consumer(docs/04 §4)。match_eventsのstatusをdeadへ
				// 反映して警報する。再試行は1回で打ち切り(隔離済みの再隔離を避ける)
				"queue": "match-events-dlq",
				"max_retries": 1
			}
		]
	},

	// パイプラインのメトリクス送信先(Analytics Engine・docs/04 §4)
	"analytics_engine_datasets": [
		{
			"binding": "PIPELINE_AX",
			"dataset": "latch_metrics"
		}
	],

	// 毎分Cron(bucket走査・期限切れバッチ等・docs/04 §2)
	"triggers": {
		"crons": ["* * * * *"]
	},

	// チャット用Durable Objects(成立LATCHごとに1DO・docs/04 §2)
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_DO",
				"class_name": "ChatRoomDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ChatRoomDO"]
		}
	],

	"vars": {
		"LATCH_LLM_MODE": "stub",
		// Web Pushの送り手(既定stub・F7b設計 §5.5)。prodはreal必須
		"LATCH_PUSH_MODE": "stub",
		// Embeddingの動作モード(既定stub・07 §2)。Parser/JevのLATCH_LLM_MODEとは独立
		"LATCH_EMBEDDING_MODE": "stub",
		// 実行環境の識別(docs/10 §1)。local既定で、デプロイ時にstaging/productionへ上書き
		"LATCH_ENV": "local"
	},

	// staging環境(F8b設計 §1・docs/04 §6)。wranglerの環境ではバインディングと
	// varsが区画へ引き継がれないため、ここで全部書き直している(書き漏れは
	// tests/wrangler-envs.test.tsが検出する)。main・assets・migrations(DO)・
	// compatibility_*は引き継がれる。triggersは明示して毎分Cronを確実に載せる。
	// 資源名は-staging付きの新規名(既存資源に触れない)。IDは
	// scripts/provision-staging.mjs --write で実IDへ置き換える(IDは秘密ではない)
	"env": {
		"staging": {
			// workers.devのURLは使う。プレビューURLは無効にし、stagingのURLが
			// 増えないようにする(F8b設計 合意#4)
			"workers_dev": true,
			"preview_urls": false,
			"triggers": {
				"crons": ["* * * * *"]
			},
			"observability": {
				"enabled": true
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "latch-db-staging",
					// 実ID(provision-staging.mjs --write が書き込む)
					"database_id": "e847caf8-1989-4028-af59-045c25afd1c5",
					"migrations_dir": "migrations"
				}
			],
			"kv_namespaces": [
				{
					"binding": "REVOCATION_KV",
					// 実ID(provision-staging.mjs --write が書き込む)
					"id": "7161f1879cf347d1a7286db069f7f8fb"
				},
				{
					"binding": "PIPELINE_KV",
					// 実ID(provision-staging.mjs --write が書き込む)
					"id": "42e39118765848bebad7f531f972d1f4"
				}
			],
			"r2_buckets": [
				{
					"binding": "ICONS",
					"bucket_name": "latch-icons-staging"
				}
			],
			"vectorize": [
				{
					"binding": "VECTORS",
					"index_name": "latch-intents-staging"
				}
			],
			"ai": {
				"binding": "AI"
			},
			"queues": {
				"producers": [
					{
						"binding": "MATCH_QUEUE",
						"queue": "match-events-staging"
					}
				],
				"consumers": [
					{
						"queue": "match-events-staging",
						"max_retries": 3,
						"max_batch_timeout": 1,
						"dead_letter_queue": "match-events-dlq-staging"
					},
					{
						"queue": "match-events-dlq-staging",
						"max_retries": 1
					}
				]
			},
			"analytics_engine_datasets": [
				{
					"binding": "PIPELINE_AX",
					"dataset": "latch_metrics_staging"
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "CHAT_DO",
						"class_name": "ChatRoomDO"
					}
				]
			},
			"vars": {
				"LATCH_ENV": "staging",
				// EmbeddingとParser/Jevがreal。Pushはstub(LLM real接続の設計 §8.1。精度ゲートの合格記録eval/records/gate.jsonが前提)
				"LATCH_EMBEDDING_MODE": "real",
				"LATCH_LLM_MODE": "real",
				"LATCH_PUSH_MODE": "stub"
			}
		}
	}
}
