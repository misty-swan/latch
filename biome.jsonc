{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"apps/**",
			"packages/**",
			"!**/worker-configuration.d.ts",
			// ビルド生成物(vite buildの出力。gitignore済みだがbiomeはファイルシステム直視のため除外)
			"!**/dist",
			// drizzle-kitの生成物(ツールが都度書き換えるため整形対象外)
			"!apps/worker/migrations",
			// wrangler dev/デプロイの一時生成物(gitignore済み・E2Eのwrangler dev起動時に作られる)
			"!apps/worker/.wrangler",
			// Playwrightの実行生成物(test-results・gitignore済み・test:e2e実行時に作られる)
			"!apps/worker/test-results",
			// prototypeから不改変で移植したデザイン定義(docs/04 §3.2・D-A-07)。整形・リント対象外とする
			"!apps/web/src/styles/latch.css",
			// prototypeから不改変で移植したPWAアイコン(F2' Task 7)。整形・リント対象外とする
			"!apps/web/public/icon.svg"
		]
	}
}
