{
  "name": "latch",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "eval:gate": "pnpm --filter eval exec tsx gate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "5.9.3"
  }
}
